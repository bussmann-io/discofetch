{
  "name": "discofetch",
  "type": "module",
  "version": "0.3.4",
  "packageManager": "pnpm@12.9.0",
  "description": "🪩 The fetch client that types itself.",
  "author": {
    "name": "Frederik Bußmann",
    "email": "frederik@bussmann.io"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bussmann-io/discofetch"
  },
  "bugs": {
    "url": "https://github.com/bussmann-io/discofetch/issues"
  },
  "keywords": [
    "api",
    "client",
    "codegen",
    "discovery",
    "fetch",
    "typescript",
    "openapi",
    "rest",
    "vite",
    "nuxt",
    "types",
    "unplugin"
  ],
  "exports": {
    ".": {
      "types": "./dist/runtime/generic/dfetch.d.ts",
      "import": "./dist/runtime/generic/dfetch.js"
    },
    "./nuxt": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./vite": {
      "types": "./dist/adapters/vite.d.mts",
      "import": "./dist/adapters/vite.mjs"
    },
    "./client": {
      "types": "./dist/runtime/client.d.ts",
      "import": "./dist/runtime/client.js"
    },
    "./types/client": {
      "types": "./dist/types/client.d.ts"
    }
  },
  "main": "./dist/runtime/generic/dfetch.js",
  "types": "./dist/runtime/generic/dfetch.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "prepack": "pnpm run prepare && pnpm run build",
    "prepare": "nuxt-module-build prepare",
    "test": "vitest",
    "lint": "eslint .",
    "nuxt:prepare": "pnpm --filter=nuxt-example run prepare",
    "nuxt:dev": "pnpm --filter=nuxt-example run dev",
    "nuxt:build": "pnpm --filter=nuxt-example run build",
    "vite:dev": "pnpm --filter=vite-example run dev",
    "vite:build": "pnpm --filter=vite-example run build",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "@nuxt/kit": "^4.5.2",
    "@nuxt/schema": "^4.5.2",
    "nuxt": "^4.5.2",
    "vite": "^7 || ^8"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "@nuxt/schema": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "autodisco": "^2.1.0",
    "consola": "^3.4.2",
    "defu": "^6.1.7",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "unplugin": "^3.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@nuxt/kit": "^4.5.2",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "nuxt": "^4.5.2",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1",
    "vue-tsc": "^3.3.12"
  }
}
